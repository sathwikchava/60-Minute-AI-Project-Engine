# Environment Configuration Example for NxtWave 60-Minute AI Project Engine
# All keys are optional: System automatically falls back to curated local blueprints and localStorage telemetry

# Optional: Gemini API Key for dynamic real-time project generation
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Supabase configuration (if swapping out default LocalStorage telemetry)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Admin Dashboard Password (Default fallback: nxtwave2025)
ADMIN_ACCESS_KEY=nxtwave2025
